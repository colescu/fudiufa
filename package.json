{
  "name": "fudiufa",
  "version": "1.0.13",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "description": "Colescu's Fuzhou Gan website",
  "scripts": {
    "dev": "pnpm --filter fuzhou-gan run dev",
    "dev:learn-mc": "pnpm --filter learn-mc run dev",
    "build": "pnpm --filter fuzhou-gan run build",
    "build:learn-mc": "pnpm --filter learn-mc run build",
    "build-v": "pnpm run build && pnpm --filter fuzhou-gan version patch --no-git-tag-version",
    "preview": "pnpm --filter fuzhou-gan run preview",
    "update": "call scripts/update.bat",
    "update-v": "pnpm run update && pnpm version patch --no-git-tag-version",
    "deploy": "dotenv -e .env -- cmd /C \"tcb hosting deploy app/dist -e %TCB_ENV_ID%\"",
    "all": "tcb login && echo. | pnpm run update && pnpm run build && pnpm run deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "dotenv-cli": "^10.0.0",
    "tsx": "^4.21.0"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "opencc-js": "^1.0.5"
  }
}
